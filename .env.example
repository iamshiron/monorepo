# Shared
ASPNETCORE_ENVIRONMENT=Development

# ──────────────────────────────────────────────
# MUTILS
# ──────────────────────────────────────────────

# MUTILS - Discord OAuth
MUTILS_DISCORD_CLIENT_ID=your_discord_client_id
MUTILS_DISCORD_CLIENT_SECRET=your_discord_client_secret
MUTILS_DISCORD_REDIRECT_URI=http://localhost:1910/auth/callback

# MUTILS - JWT
MUTILS_JWT_AUDIENCE=mutils-users
MUTILS_JWT_EXPIRY_HOURS=24
MUTILS_JWT_ISSUER=mutils
MUTILS_JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# MUTILS - PostgreSQL
MUTILS_POSTGRES_DB=mutils
MUTILS_POSTGRES_HOST=localhost
MUTILS_POSTGRES_PASSWORD=your_postgres_password
MUTILS_POSTGRES_PORT=5432
MUTILS_POSTGRES_USER=mutils

# MUTILS - Connection String
MUTILS_ConnectionStrings__Default=Host=localhost;Port=5432;Database=mutils;Username=mutils;Password=your_postgres_password

# MUTILS - MinIO
MUTILS_MINIO_ACCESS_KEY=your_minio_access_key
MUTILS_MINIO_BUCKET_ASSETS=mutils-assets
MUTILS_MINIO_BUCKET_USER_DATA=mutils-user-data
MUTILS_MINIO_ENDPOINT=localhost:9000
MUTILS_MINIO_SECRET_KEY=your_minio_secret_key
MUTILS_MINIO_USE_SSL=false

# ──────────────────────────────────────────────
# HONAMIG
# ──────────────────────────────────────────────

# HONAMIG - PostgreSQL
HONAMIG_POSTGRES_DB=honamig
HONAMIG_POSTGRES_HOST=localhost
HONAMIG_POSTGRES_PASSWORD=your_postgres_password
HONAMIG_POSTGRES_PORT=5432
HONAMIG_POSTGRES_USER=admin

# HONAMIG - Connection String
HONAMIG_ConnectionStrings__Default=Host=localhost;Port=5432;Database=honamig;Username=admin;Password=your_postgres_password

# ──────────────────────────────────────────────
# BEATDASH
# ──────────────────────────────────────────────

# BEATDASH - PostgreSQL
BEATDASH_POSTGRES_DB=beatdash
BEATDASH_POSTGRES_PASSWORD=your_postgres_password
BEATDASH_POSTGRES_PORT=5432
BEATDASH_POSTGRES_USER=admin

# BEATDASH - Connection String
BEATDASH_ConnectionStrings__Default=Host=localhost;Port=5432;Database=beatdash;Username=admin;Password=your_postgres_password

# ──────────────────────────────────────────────
# FRONTEND (exposed to browser)
# ──────────────────────────────────────────────

VITE_HONAMIG_API_URL=http://localhost:2014
VITE_MUTILS_API_URL=http://localhost:2010
VITE_MUTILS_DISCORD_CLIENT_ID=your_discord_client_id
VITE_MUTILS_DISCORD_REDIRECT_URI=http://localhost:1910/auth/callback
