# Docker Environment Overrides
# Copy to .env in the docker directory or set in parent .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admin
POSTGRES_PORT=5432

# MinIO
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO Buckets - Mutils
MUTILS_MINIO_BUCKET_ASSETS=mutils-assets
MUTILS_MINIO_BUCKET_USER_DATA=mutils-user-data

# MinIO Buckets - Archive
ARCHIVE_MINIO_BUCKET_ASSETS=archive-assets
ARCHIVE_MINIO_BUCKET_USER_DATA=archive-user-data

# MinIO Buckets - Honamig
HONAMIG_MINIO_BUCKET_ASSETS=honamig-assets
HONAMIG_MINIO_BUCKET_USER_DATA=honamig-user-data
